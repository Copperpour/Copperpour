  (network
    (net VCC
      (pins R1-1 R2-2 J1-1 U1-1 U1-3 R3-1)
    )
    (net GND
      (pins R1-2 R2-1 J1-2 U1-2 R3-2)
    )
    (class kicad_default GND VCC
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
    (wire (path F.Cu 250  100500 -50000  105000 -50000)(net GND)(type fix))
    (wire (path In1.Cu 250  105000 -50000  105000 -55000)(net GND)(type fix))
    (via "Via[0-3]_600:300_um"  105000 -50000 (net GND)(type fix))
  )
)
