(pcb "board.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.6-10.0.6~ubuntu22.04.1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer In1.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (layer In2.Cu
      (type signal)
      (property
        (index 2)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 3)
      )
    )
    (boundary
      (path pcb 0  130000 -70000  80000 -70000  80000 -30000  130000 -30000
            130000 -70000)
    )
    (via "Via[0-3]_600:300_um")
    (rule
      (width 200)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component PinHeader_1x02_P2.54mm_Horizontal
      (place J2 115000 -58000 back 0 (PN PinHeader_1x02_P2.54mm_Horizontal))
    )
    (component Resistor_SMD:R_0402
      (place R1 100000 -50000 front 0 (PN 10k))
      (place R2 110000 -50000 front 0 (PN 4.7k))
    )
    (component PinHeader_1x02_P2.54mm_Vertical
      (place J1 120000 -45000 front 0 (PN PinHeader_1x02_P2.54mm_Vertical))
    )
  )
  (library
    (image PinHeader_1x02_P2.54mm_Horizontal
      (outline (polygon signal 0  -1765 1765  10535 1765  10535 -4315  -1765 -4315))
      (outline (path signal 120  -1270 1270  0 1270))
      (outline (path signal 120  -1270 0  -1270 1270))
      (outline (path signal 120  1077.36 -2110  1390 -2110))
      (outline (path signal 120  1077.36 -2970  1390 -2970))
      (outline (path signal 120  1160 430  1390 430))
      (outline (path signal 120  1160 -430  1390 -430))
      (outline (path signal 120  1390 -1270  4150 -1270))
      (outline (path signal 120  4150 -2110  10150 -2110))
      (outline (path signal 120  10150 -2110  10150 -2970))
      (outline (path signal 120  10150 -2970  4150 -2970))
      (outline (path signal 120  1390 1380  4150 1380  4150 -3920  1390 -3920  1390 1380))
      (outline (path signal 120  4150 430  10150 430  10150 -430  4150 -430  4150 430))
      (outline (path signal 100  -320 320  -320 -320))
      (outline (path signal 100  -320 320  1500 320))
      (outline (path signal 100  -320 -320  1500 -320))
      (outline (path signal 100  -320 -2220  -320 -2860))
      (outline (path signal 100  -320 -2220  1500 -2220))
      (outline (path signal 100  -320 -2860  1500 -2860))
      (outline (path signal 100  1500 635  2135 1270))
      (outline (path signal 100  1500 -3810  1500 635))
      (outline (path signal 100  2135 1270  4040 1270))
      (outline (path signal 100  4040 1270  4040 -3810))
      (outline (path signal 100  4040 320  10040 320))
      (outline (path signal 100  4040 -320  10040 -320))
      (outline (path signal 100  4040 -2220  10040 -2220))
      (outline (path signal 100  4040 -2860  10040 -2860))
      (outline (path signal 100  4040 -3810  1500 -3810))
      (outline (path signal 100  10040 320  10040 -320))
      (outline (path signal 100  10040 -2220  10040 -2860))
      (pin Rect[T1]Pad_1700.000000x1700.000000_um 1 0 0)
      (pin Round[T2]Pad_1700.000000_um 2 0 -2540)
    )
    (image Resistor_SMD:R_0402
      (pin Rect[T]Pad_600.000000x500.000000_um 1 -500 0)
      (pin Rect[T]Pad_600.000000x500.000000_um 2 500 0)
    )
    (image PinHeader_1x02_P2.54mm_Vertical
      (outline (polygon signal 0  1765 -4315  -1765 -4315  -1765 1765  1765 1765))
      (outline (path signal 120  -1380 1380  0 1380))
      (outline (path signal 120  -1380 0  -1380 1380))
      (outline (path signal 120  -1380 -1270  -1380 -3920))
      (outline (path signal 120  -1380 -1270  1380 -1270))
      (outline (path signal 120  -1380 -3920  1380 -3920))
      (outline (path signal 120  1380 -1270  1380 -3920))
      (outline (path signal 100  -1270 635  -635 1270))
      (outline (path signal 100  -1270 -3810  -1270 635))
      (outline (path signal 100  -635 1270  1270 1270))
      (outline (path signal 100  1270 1270  1270 -3810))
      (outline (path signal 100  1270 -3810  -1270 -3810))
      (pin Rect[T1]Pad_1700.000000x1700.000000_um 1 0 0)
      (pin Round[T2]Pad_1700.000000_um 2 0 -2540)
    )
    (padstack Round[T2]Pad_1700.000000_um
      (shape (circle F.Cu 1700))
      (shape (circle In2.Cu 1700))
      (attach off)
    )
    (padstack Rect[T]Pad_600.000000x500.000000_um
      (shape (rect F.Cu -300 -250 300 250))
      (attach off)
    )
    (padstack Rect[T1]Pad_1700.000000x1700.000000_um
      (shape (rect F.Cu -850 -850 850 850))
      (shape (rect In1.Cu -850 -850 850 850))
      (attach off)
    )
    (padstack "Via[0-3]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle In1.Cu 600))
      (shape (circle In2.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net VCC
      (pins J2-1 R1-1 R2-2 J1-1)
    )
    (net GND
      (pins J2-2 R1-2 R2-1 J1-2)
    )
    (class kicad_default GND VCC
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
