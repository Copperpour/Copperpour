(module THT_Legacy (layer F.Cu) (tedit 5B307E4C)
  (descr "A hand-written KiCad 5 footprint exercising the legacy forms KiCad 10 converts on load")
  (tags "legacy test")
  (solder_mask_margin 0)
  (fp_text reference REF** (at 0 -2.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value ~RST~_N (at 0 2.5) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab) hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -2 -1.5) (end 2 -1.5) (layer F.SilkS) (width 0.12))
  (pad 1 thru_hole oval (at -1.27 0) (size 1.2 1.8) (drill oval 0.8 0.8) (layers *.Cu F.Mask B.Mask))
  (pad 2 thru_hole circle (at 1.27 0) (size 1.2 1.2) (drill 0.8 (offset 0 0)) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at 0 1) (size 1 1) (drill 1) (layers F&B.Cu *.Mask))
  (pad 3 smd rect (at 3 0) (size 1 1) (drill 0) (layers F.Cu F.Paste F.Mask) (solder_paste_margin 0))
  (model ${KISYS3DMOD}/Legacy.3dshapes/THT_Legacy.wrl
    (at (xyz 0 0 0.04))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
